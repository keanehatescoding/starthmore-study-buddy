# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://studybuddy:studybuddy@localhost:5432/studybuddy

# Moodle (token auth, see login/token.php)
MOODLE_BASE_URL=https://elearning.strathmore.edu
MOODLE_TOKEN=

# Google Classroom OAuth (Web application type, Testing status)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Saved after first consent flow; .gitignore'd
GOOGLE_REFRESH_TOKEN=

# LLM (OpenAI-compatible endpoint; chunking uses the cheap model)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHUNK_MODEL=gemini-3.6-flash
LLM_QUIZ_MODEL=gemini-3.6-flash
LLM_GRADE_MODEL=gemini-3.6-flash

# Notifications (Resend free tier: api.resend.com, verified sender required)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Web sessions (generate: openssl rand -hex 32; set cookie secure in prod)
SECRET_KEY=dev-insecure-change-me
SESSION_SECURE_COOKIE=false
